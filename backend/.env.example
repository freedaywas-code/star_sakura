DJANGO_SETTINGS_MODULE=configs.settings.dev
DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0
CORS_ALLOW_ALL_ORIGINS=true
SQLITE_NAME=db.sqlite3

# Platform official AI assistant (OpenAI-compatible; defaults use Zhipu GLM)
AI_API_KEY=
AI_API_BASE=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-4-flash
AI_API_TIMEOUT=60
AI_DNS_TIMEOUT=5
AI_DNS_MAX_CONCURRENCY=2
AI_CUSTOM_MAX_CONCURRENCY=4
AI_OFFICIAL_MAX_CONCURRENCY=4
AI_MAX_INPUT_LENGTH=2000
AI_MAX_OUTPUT_LENGTH=12000
DRF_AI_CHAT_THROTTLE_RATE=20/min
# Fernet key for encrypting users' custom model credentials.
# Development may leave it blank and derive from DJANGO_SECRET_KEY; production requires a generated Fernet key.
AI_CREDENTIAL_ENCRYPTION_KEY=
DRF_AI_SETTINGS_THROTTLE_RATE=30/min
DRF_AI_SETTINGS_TEST_THROTTLE_RATE=5/min

# Production example:
# DJANGO_SETTINGS_MODULE=configs.settings.prod
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# DATABASE_ENGINE=postgresql
# POSTGRES_DB=star_sakura
# POSTGRES_USER=star_sakura
# POSTGRES_PASSWORD=change-this-too
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# DB_CONN_MAX_AGE=60
# REDIS_URL=redis://redis:6379/1
# DRF_ANON_THROTTLE_RATE=120/min
# DRF_USER_THROTTLE_RATE=1200/min
# DRF_LOGIN_THROTTLE_RATE=10/min
# DRF_WRITE_THROTTLE_RATE=120/min
# DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
# FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
# MAX_IMAGE_UPLOAD_SIZE=5242880
# PUBLIC_API_CACHE_TIMEOUT=30
